# Copy this file to .env and fill in real values.
# .env must never be committed to Git. Everything below is a placeholder.

# ---- Database ----
# Supabase: Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres
# Local PostgreSQL example:
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/skilling_db

# ---- Authentication (JWT) ----
# At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=60

# admin: manages trainee/training/outcome/follow-up/employment records (PII)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# analyst: aggregated analytics and insights only (no personal data)
ANALYST_USERNAME=analyst
ANALYST_PASSWORD=replace-with-a-strong-password

# ---- Automated follow-up contact (all optional) ----
# Base URL used in self-report / employer-confirmation links sent to people
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Frontend addresses allowed to call the API from a browser (comma-separated).
# Unset = http://localhost:3000 and :5173 (and 127.0.0.1 equivalents).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Run the follow-up dispatcher automatically every N hours (0 = off; use
# POST /api/followups/dispatch-due instead)
FOLLOWUP_AUTO_DISPATCH_HOURS=0
# Email delivery. Without SMTP_HOST, email messages wait in the outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# SMS / WhatsApp gateway: receives POST {"to": "...", "message": "..."} (JSON).
# Without it, SMS messages wait in the outbox for staff.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
